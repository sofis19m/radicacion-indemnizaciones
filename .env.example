# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Modelo (Google AI Studio > Get API key) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_RESPALDO=gemini-3.5-flash-lite

# --- App ---
APP_URL=http://localhost:3000
# Secreto que usa pg_cron para invocar /api/cron/tick (genere uno largo y aleatorio)
CRON_SECRET=
# Sal para anonimizar IPs en el control de abuso
HASH_SALT=

# --- Correo (Gmail con contraseña de aplicación). Si falta, las notificaciones quedan "omitidas" ---
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Reclamaciones Seguros de Vida
# Destino de las alertas internas (coma para varios). Vacío = correos de los analistas activos
ALERTAS_EMAIL=
